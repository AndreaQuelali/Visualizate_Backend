# ──────────────────────────────────────────────
# App
# ──────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Orígenes permitidos por CORS, separados por comas
CORS_ORIGINS=http://localhost:5173
# Tamaño máximo de cuerpos JSON/formulario, en MB
BODY_LIMIT_MB=2
# Si se define, GET /metrics exige "Authorization: Bearer <token>"
METRICS_TOKEN=
# Peticiones por minuto: por IP (global) y por usuario autenticado
THROTTLE_IP_LIMIT=300
THROTTLE_USER_LIMIT=120
# false en el contenedor de la API; el worker corre aparte con `node dist/src/worker`
RUN_WORKERS=true

# ──────────────────────────────────────────────
# Database (PostgreSQL via Prisma)
# ──────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB_NAME?schema=public"

# ──────────────────────────────────────────────
# JWT
# ──────────────────────────────────────────────
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN_SECONDS=86400

# ──────────────────────────────────────────────
# Redis (for BullMQ)
# ──────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=

# ──────────────────────────────────────────────
# MinIO (Object Storage)
# ──────────────────────────────────────────────
MINIO_ENDPOINT=localhost
MINIO_PORT=9002
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=visualizate

# ──────────────────────────────────────────────
# SMTP Mailer (Mailpit in dev / Gmail in prod)
# ──────────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Visualizate <no-reply@visualizate.local>"

# ──────────────────────────────────────────────
# Cuotas técnicas por workspace (402 al superarlas)
# ──────────────────────────────────────────────
QUOTA_STORAGE_MB=200
QUOTA_ACTIVE_PIECES=500
QUOTA_RENDERS_PER_MONTH=500

# ──────────────────────────────────────────────
# Render PNG/PDF (worker + Chromium)
# ──────────────────────────────────────────────
RENDER_CONCURRENCY=2
RENDER_RETENTION_DAYS=30
RENDER_MAX_ACTIVE=3
RENDER_MAX_PER_HOUR=20

# ──────────────────────────────────────────────
# Revisión con IA (sin clave solo corren las reglas automáticas)
# ──────────────────────────────────────────────
OPENAI_API_KEY=
AI_MODEL=gpt-4o
AI_TIMEOUT_MS=60000
REVIEW_CONCURRENCY=2
REVIEW_MAX_PER_PIECE_HOUR=10
REVIEW_MONTHLY_QUOTA=100