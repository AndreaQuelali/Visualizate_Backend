// This is your Prisma schema file.
// Database URL is configured in prisma.config.ts — not here.
// learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum WorkspaceRole {
  ADMIN
  DESIGNER
  ORGANIZER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  CANCELLED
}

enum AssetKind {
  IMAGE
  LOGO
  FONT
}

enum ReviewStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

enum ReviewCategory {
  LEGIBILITY
  COMPOSITION
  CONTENT
  BRAND
}

enum ReviewSeverity {
  INFO
  WARNING
  CRITICAL
}

enum ReviewSource {
  RULE
  AI
}

enum ReviewItemStatus {
  PENDING
  APPLIED
  DISMISSED
  STALE
}

enum RenderFormat {
  PNG
  PDF
}

enum RenderStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum PieceStatus {
  DRAFT
  READY
  ARCHIVED
}

enum TemplateStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model User {
  id           String               @id @default(uuid())
  email        String               @unique
  passwordHash String
  fullName     String
  isVerified   Boolean              @default(false)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  resetTokens  PasswordResetToken[]
  verifyTokens VerificationToken[]
  memberships  WorkspaceMember[]

  @@map("users")
}

model VerificationToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("verification_tokens")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("password_reset_tokens")
}

model Workspace {
  id              String                @id @default(uuid())
  name            String
  description     String?
  logoUrl         String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  members         WorkspaceMember[]
  invitations     WorkspaceInvitation[]
  brandKit        BrandKit?
  assets          Asset[]
  templates       Template[]
  pieces          Piece[]
  renderJobs      RenderJob[]
  reviews         Review[]
  aiReviewEnabled Boolean               @default(true)

  @@map("workspaces")
}

model WorkspaceMember {
  id          String        @id @default(uuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(DESIGNER)
  joinedAt    DateTime      @default(now())
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@map("workspace_members")
}

model WorkspaceInvitation {
  id          String           @id @default(uuid())
  workspaceId String
  email       String
  role        WorkspaceRole    @default(DESIGNER)
  status      InvitationStatus @default(PENDING)
  token       String           @unique
  expiresAt   DateTime
  createdAt   DateTime         @default(now())
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, email])
  @@map("workspace_invitations")
}

model BrandKit {
  id          String    @id @default(uuid())
  workspaceId String    @unique
  colors      Json      @default("[]")
  fonts       Json      @default("[]")
  logoAssetId String?
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("brand_kits")
}

model Asset {
  id          String    @id @default(uuid())
  workspaceId String
  kind        AssetKind
  name        String
  objectKey   String
  mimeType    String
  sizeBytes   Int
  width       Int?
  height      Int?
  createdById String
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, kind])
  @@map("assets")
}

model Template {
  id               String            @id @default(uuid())
  workspaceId      String
  name             String
  description      String?
  status           TemplateStatus    @default(DRAFT)
  currentVersionId String?
  createdById      String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  workspace        Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  versions         TemplateVersion[]
  pieces           Piece[]

  @@index([workspaceId, status])
  @@map("templates")
}

model TemplateVersion {
  id          String    @id @default(uuid())
  templateId  String
  version     Int
  document    Json
  publishedAt DateTime?
  createdById String
  createdAt   DateTime  @default(now())
  template    Template  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  pieces      Piece[]

  @@unique([templateId, version])
  @@map("template_versions")
}

model Piece {
  id                String          @id @default(uuid())
  workspaceId       String
  templateId        String
  templateVersionId String
  title             String
  data              Json            @default("{}")
  overrides         Json            @default("{}")
  status            PieceStatus     @default(DRAFT)
  createdById       String
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  workspace         Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  template          Template        @relation(fields: [templateId], references: [id], onDelete: Restrict)
  templateVersion   TemplateVersion @relation(fields: [templateVersionId], references: [id], onDelete: Restrict)
  renderJobs        RenderJob[]
  reviews           Review[]

  @@index([workspaceId, status])
  @@index([workspaceId, updatedAt])
  @@map("pieces")
}

model RenderJob {
  id                String       @id @default(uuid())
  workspaceId       String
  pieceId           String
  format            RenderFormat
  scale             Float        @default(1)
  status            RenderStatus @default(QUEUED)
  inputHash         String
  templateVersionId String
  inputData         Json
  inputOverrides    Json         @default("{}")
  attempts          Int          @default(0)
  errorCode         String?
  errorMessage      String?
  outputObjectKey   String?
  outputBytes       Int?
  durationMs        Int?
  requestedById     String
  createdAt         DateTime     @default(now())
  finishedAt        DateTime?
  workspace         Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  piece             Piece        @relation(fields: [pieceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, pieceId, createdAt])
  @@index([workspaceId, status])
  @@index([workspaceId, createdAt])
  @@index([workspaceId, pieceId, status])
  @@index([pieceId, inputHash])
  @@map("render_jobs")
}

model Review {
  id            String       @id @default(uuid())
  workspaceId   String
  pieceId       String
  status        ReviewStatus @default(QUEUED)
  aiStatus      String       @default("PENDING")
  summary       String?
  model         String?
  tokensIn      Int?
  tokensOut     Int?
  errorMessage  String?
  snapshotHash  String
  requestedById String
  createdAt     DateTime     @default(now())
  finishedAt    DateTime?
  workspace     Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  piece         Piece        @relation(fields: [pieceId], references: [id], onDelete: Cascade)
  items         ReviewItem[]

  @@index([workspaceId, pieceId, createdAt])
  @@index([workspaceId, createdAt])
  @@map("reviews")
}

model ReviewItem {
  id          String           @id @default(uuid())
  reviewId    String
  category    ReviewCategory
  severity    ReviewSeverity
  source      ReviewSource
  title       String
  explanation String
  target      Json?
  patch       Json?
  status      ReviewItemStatus @default(PENDING)
  decidedById String?
  decidedAt   DateTime?
  createdAt   DateTime         @default(now())
  review      Review           @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId])
  @@index([reviewId, status])
  @@map("review_items")
}
